eval "$(/opt/homebrew/bin/brew shellenv)"

# Java / Maven / JetBrains: only added if present on this machine
[ -d "/Library/Java/JavaVirtualMachines/jdk-21.jdk" ] && export JAVA_HOME="/Library/Java/JavaVirtualMachines/jdk-21.jdk/Contents/Home"
command -v mvn >/dev/null && export M2_HOME="$(brew --prefix maven)/libexec"
export JETBRAINS_TOOL_BOX="$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
export PATH="$PATH:$JETBRAINS_TOOL_BOX${JAVA_HOME:+:$JAVA_HOME/bin}${M2_HOME:+:$M2_HOME/bin}"
